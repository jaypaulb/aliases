#
# Custom Bash Aliases
#

#==============================================================================
# General Aliases & ls
#==============================================================================

# ll: List all files in long format, human-readable, including hidden files.
# Example: ll
alias ll='eza -alFh --color=auto'

# la: List all files, including hidden files, with human-readable sizes.
# Example: la
alias la='eza -Ah --color=auto'

# l: List files in a column format, colorized.
# Example: l
alias l='eza -G'

# lss: List files sorted by size (largest first), with human-readable sizes.
# Example: lss
alias lss='eza -lhr --sort size'

# lst: List files sorted by modification time (newest first), with human-readable sizes.
# Example: lst
alias lst='eza -lhr --sort modified'


#==============================================================================
# Alias Management
#==============================================================================

# addalias: Add a new alias to the custom aliases file and reload.
# Example: addalias myalias='my command'
addalias() {
    echo "alias $1" >> /home/jaypaulb/.aliases_custom
    reload-aliases
}

# reload-aliases: Reload the aliases in the current shell.
# Example: reload-aliases
alias reload-aliases='source /home/jaypaulb/aliases/aliases; [ -f /home/jaypaulb/.aliases_custom ] && source /home/jaypaulb/.aliases_custom'

# aliases: List all defined aliases.
# Example: aliases
alias aliases='alias'


#==============================================================================
# Filesystem Navigation
#==============================================================================



# .2: Go up two directories.
# Example: .2
alias .2='cd ../..'

# .3: Go up three directories.
# Example: .3
alias .3='cd ../../..'

# .4: Go up four directories.
# Example: .4
alias .4='cd ../../../..'

# .5: Go up five directories.
# Example: .5
alias .5='cd ../../../../..'

# mkcd: Create a directory and immediately change into it.
# Example: mkcd new_project
mkcd() {
    mkdir -p "$1" && cd "$1";
}


#==============================================================================
# Deletion & Cleanup
#==============================================================================

# rmempty: Recursively delete all empty directories from the current location.
# Example: rmempty
alias rmempty='find . -type d -empty -delete'

# rmemptyfiles: Recursively delete all empty files (0 bytes) from the current location.
# Example: rmemptyfiles
alias rmemptyfiles='find . -type f -empty -delete'

# rmi: Interactive 'rm'. Prompts for confirmation before deleting.
# Example: rmi somefile.txt
alias rmi='rm -i'

# trash: Move specified files to a ~/.trash directory instead of deleting.
# Example: trash old_document.txt
trash() {
    mkdir -p ~/.trash && mv "$@" ~/.trash;
}


#==============================================================================
# Searching
#==============================================================================

# findf: Find a file by name in the current directory.
# Example: findf "config.yml"
findf() {
    find . -name "$1" ;
}

# grepi: Recursively and case-insensitively search for a pattern in files.
# Example: grepi "database_url"
grepi() {
    grep -ri "$1" . ;
}


#==============================================================================
# Disk Usage
#==============================================================================

# dus: Show a human-readable summary of the current directory's total size.
# Example: dus
alias dus='du -sh .'

# dush: Show a human-readable size for each file/directory in the current path.
# Example: dush
alias dush='du -sh *'

# dfh: Show free disk space on all mounted filesystems in a human-readable format.
# Example: dfh
alias dfh='df -h'


#==============================================================================
# Applications & Tools
#==============================================================================

#------------------------------------------------------------------------------
# Antigravity Shortcuts
#------------------------------------------------------------------------------

# agy: Launch Antigravity.
# Note: The 'agy' command does not support model selection via command line.
# These aliases have been simplified to use the correct flags.
alias agy='agy'

# agpy: Launch Antigravity with permissions automatically skipped (YOLO mode)
# and include the gemini_config directory.
# Example: agpy
alias agpy='agy --dangerously-skip-permissions --add-dir ~/gemini_config/'

# ag: Interactive launcher for Antigravity.
# Note: This function is preserved for consistency, but 'agy' does not support
# model selection. It will launch 'agy' with or without YOLO mode.
# Example: ag
# Example: ag -y
ag() {
    echo "Note: The 'agy' command does not support model selection from the command line."
    
    local yolo_flag=""
    local yolo_msg=""

    # Check if the first argument is '-y' or 'y'
    if [[ "$1" == "-y" || "$1" == "y" ]]; then
        yolo_flag="--dangerously-skip-permissions"
        yolo_msg=" in YOLO mode"
    fi

    echo "Launching Antigravity${yolo_msg}..."
    echo "Command: agy ${yolo_flag} --add-dir ~/gemini_config/"
    agy ${yolo_flag} --add-dir ~/gemini_config/
}

#------------------------------------------------------------------------------
# Gemini Shortcuts (restored 2026-06-14 — kept alongside Antigravity)
#------------------------------------------------------------------------------

# gmf: Launch Gemini with the 2.5 Flash model.
# Example: gmf
alias gmf='gemini -m gemini-2.5-flash --include-directories ~/gemini_config/'

# gmfy: Launch Gemini with the 2.5 Flash model in YOLO mode.
# Example: gmfy
alias gmfy='gemini -m gemini-2.5-flash -y --include-directories ~/gemini_config/'

# gmp: Launch Gemini with the 2.5 Pro model.
# Example: gmp
alias gmp='gemini -m gemini-2.5-pro --include-directories ~/gemini_config/'

# gmpy: Launch Gemini with the 2.5 Pro model in YOLO mode.
# Example: gmpy
alias gmpy='gemini -m gemini-2.5-pro -y --include-directories ~/gemini_config/'


# gm: Interactively select a Gemini model to launch.
# Pass '-y' or 'y' as an argument to enable YOLO mode.
# Example: gm
# Example: gm -y
gm() {
    local models=(
        "gemini-2.5-pro"
        "gemini-2.5-flash"
        "gemini-2.5-flash-lite"
    )
    local yolo_flag=""

    # Check if the first argument is '-y' or 'y'
    if [[ "$1" == "-y" || "$1" == "y" ]]; then
        yolo_flag="-y"
    fi

    echo "Select a Gemini model to use:"
    select model in "${models[@]}"; do
        if [[ -n "$model" ]]; then
            echo "Launching: gemini -m $model $yolo_flag --include-directories ~/gemini_config/"
            gemini -m "$model" $yolo_flag --include-directories ~/gemini_config/
            break
        else
            echo "Invalid selection. Please try again."
        fi
    done
}

# gmy: Interactively select a Gemini model to launch in YOLO mode.
# Example: gmy
alias gmy='gm -y'

