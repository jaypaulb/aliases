#------------------------------------------------------------------------------
# Codex Shortcuts (added 2026-06-14)
#------------------------------------------------------------------------------
# Codex has no friendly model nicknames; default model is set in
# ~/.codex/config.toml (currently gpt-5.5). Its real "power tier" dial is
# model_reasoning_effort (low/medium/high) — the analog to Claude's
# haiku/opus/sonnet tiers. YOLO == --dangerously-bypass-approvals-and-sandbox.

# cx: Launch Codex normally (config default model + reasoning effort).
# Example: cx
alias cx='codex'

# cxy: Launch Codex in YOLO mode (skip all approvals + sandbox).
# Example: cxy
alias cxy='codex --dangerously-bypass-approvals-and-sandbox'

# cxl / cxm / cxh: Launch Codex at low / medium / high reasoning effort.
# Example: cxh
alias cxl='codex -c model_reasoning_effort="low"'
alias cxm='codex -c model_reasoning_effort="medium"'
alias cxh='codex -c model_reasoning_effort="high"'

# cxly / cxmy / cxhy: Same reasoning tiers in YOLO mode.
# Example: cxhy
alias cxly='codex -c model_reasoning_effort="low"    --dangerously-bypass-approvals-and-sandbox'
alias cxmy='codex -c model_reasoning_effort="medium" --dangerously-bypass-approvals-and-sandbox'
alias cxhy='codex -c model_reasoning_effort="high"   --dangerously-bypass-approvals-and-sandbox'

# cl: Interactively select a Claude model to launch.
# Pass '-y' or 'y' as an argument to enable YOLO mode.
# Example: cl
# Example: cl -y
cl() {
    local models=(
        "sonnet"
        "opus"
        "haiku"
    )
    local yolo_flag=""

    # Check if the first argument is '-y' or 'y'
    if [[ "$1" == "-y" || "$1" == "y" ]]; then
        yolo_flag="--allow-dangerously-skip-permissions"
    fi

    echo "Select a Claude model to use:"
    select model in "${models[@]}"; do
        if [[ -n "$model" ]]; then
            echo "Launching: claude -m $model $yolo_flag"
            claude -m "$model" $yolo_flag
            break
        else
            echo "Invalid selection. Please try again."
        fi
    done
}

# cly_interactive: Interactively select a Claude model to launch in YOLO mode.
# Example: cly_interactive
alias cly_interactive='cl -y'

